# ==============================================================================
# LATUS CRM - BACKEND ENVIRONMENT VARIABLES (DESARROLLO LOCAL)
# ==============================================================================

# Entorno: development, staging o production
ENVIRONMENT=development
APP_VERSION=local

# URL de la Base de Datos MongoDB (Atlas o Local)
MONGO_URL=mongodb+srv://<usuario>:<password>@cluster0.xxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=latus-crm-dev

# URL pública del backend
PUBLIC_BASE_URL=http://localhost:8000

# URL pública del frontend (retorno de pagos y enlaces del CRM)
APP_BASE_URL=http://localhost:3000

# Orígenes Permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Mercado Pago (Credenciales de Prueba para Desarrollo Local)
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MERCADOPAGO_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx
MERCADOPAGO_MODE=test
BILLING_GRACE_DAYS=7

# Seguridad y administración de la plataforma
APP_ENCRYPTION_KEY=<clave-fernet-base64-de-32-bytes>
PLATFORM_ADMIN_EMAILS=tu-email@dominio.com
DEFAULT_ORGANIZATION_NAME=Latus CRM
LATUS_SEED_DEMO=false
# En Producción, activar únicamente después de completar y verificar el backup.
LATUS_CONFIRM_PRODUCTION_MIGRATION=false

# Claves de LLM e IA
LATUS_LLM_KEY=sk-xxxxxxxxx

# Servicio de Emails (Resend)
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=notificaciones@somoslatus.com
RESEND_FROM_NAME="Latus CRM"

# WhatsApp Cloud API (también puede configurarse desde el CRM)
WHATSAPP_VERIFY_TOKEN=xxxxxxxxxxxxxxxx
WHATSAPP_ACCESS_TOKEN=xxxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=000000000000000
WHATSAPP_BUSINESS_ACCOUNT_ID=000000000000000
WHATSAPP_APP_SECRET=xxxxxxxxxxxxxxxx
WHATSAPP_API_VERSION=v21.0
